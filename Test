];
const FRAME_ICON = `<svg viewBox="0 0 24 24"><circle cx="6" cy="12" r="4"/><circle cx="18" cy="12" r="4"/><path d="M10 12h4"/><path d="M2 12c0-1 .5-2 1.5-2"/><path d="M22 12c0-1-.5-2-1.5-2"/></svg>`;

/* =============================================================
   STORAGE ADAPTER
   -------------------------------------------------------------
   Placeholder using localStorage so the app already works and
   persists data in this browser. When your own storage (REST
   API, Firebase, Supabase, etc.) is ready, only the 4 methods
   below need to change — save / load / list / remove. Nothing
   else in the app talks to localStorage directly, so swapping
   the implementation here is enough.

   Example swap for a REST API:
     async save(orderId, data){
       const res = await fetch(`${API_BASE}/orders/${orderId}`, {
         method: 'PUT',
         headers: {'Content-Type':'application/json'},
         body: JSON.stringify(data)
       });
       return res.ok;
     }
   ============================================================= */
const Storage = {
  _prefix: 'blueoptikal:order:',
  _lastKey: 'blueoptikal:lastOrder',

  async save(orderId, data){
    try{
      localStorage.setItem(this._prefix + orderId, JSON.stringify({ ...data, _updatedAt: Date.now() }));
      localStorage.setItem(this._lastKey, orderId);
      return true;
    }catch(err){
      console.error('Storage.save failed:', err);
      return false;
    }
  },

  async load(orderId){
    try{
      const raw = localStorage.getItem(this._prefix + orderId);
      return raw ? JSON.parse(raw) : null;
    }catch(err){
      console.error('Storage.load failed:', err);
      return null;
    }
  },

  async list(){
    try{
      return Object.keys(localStorage)
        .filter(k => k.startsWith(this._prefix))
        .map(k => k.slice(this._prefix.length));
    }catch(err){
      console.error('Storage.list failed:', err);
      return [];
    }
  },

  async remove(orderId){
    try{
      localStorage.removeItem(this._prefix + orderId);
      return true;
    }catch(err){
      console.error('Storage.remove failed:', err);
      return false;
    }
  },

  getLastOrderId(){
    try{ return localStorage.getItem(this._lastKey); }
    catch(err){ return null; }
  }
};

let _saveTimer = null;
function persist(){
  clearTimeout(_saveTimer);
  _saveTimer = setTimeout(()=>{
    Storage.save(state.orderId, { ...state, currentView });
    const dot = document.getElementById('saveDot');
    if(dot){ dot.classList.add('flash'); setTimeout(()=>dot.classList.remove('flash'), 700); }
  }, 350);
}

const state = {
  customer:{name:'',phone:'',gender:'',age:'',addr:'',note:'',resep:''},
  selectedFrame: null,
  selectedLens: null,
  genderFilter: 'Semua',
  inCart:false,
  fulfil:'store',
  payMethod:'va',
  orderId: genOrderId(),
};

function genOrderId(){
  const d = new Date();
  const p = n=>String(n).padStart(2,'0');
  return `BO-${d.getFullYear()}${p(d.getMonth()+1)}${p(d.getDate())}-${Math.floor(1000+Math.random()*9000)}`;
}
function rupiah(n){ return 'Rp ' + n.toLocaleString('id-ID'); }

/* ---------- NAV ---------- */
const VIEWS = ['pemeriksaan','frame','pemesanan','pembayaran'];
let currentView = 'pemeriksaan';

function goTo(view){
  if((view === 'pemesanan' || view === 'pembayaran') && (!state.selectedFrame || !state.selectedLens)){
    showToast('Harap isi atau memilih terlebih dahulu', 'Pilih frame dan jenis lensa terlebih dahulu.');
    view = 'frame';
  }
  currentView = view;
  VIEWS.forEach(v=>{
    document.getElementById('view-'+v).style.display = (v===view)?'block':'none';
  });
  document.querySelectorAll('#stepper .step-item').forEach(el=>{
    const v = el.dataset.view;
    el.classList.toggle('active', v===view);
    el.classList.toggle('done', VIEWS.indexOf(v) < VIEWS.indexOf(view));
  });
  window.scrollTo({top:0,behavior:'smooth'});
  renderAll();
  persist();
}
document.querySelectorAll('#stepper .step-item').forEach(el=>{
  el.addEventListener('click', ()=>goTo(el.dataset.view));
});

/* ---------- PEMERIKSAAN ---------- */
document.getElementById('noPeriksa').value = 'PX-' + state.orderId.split('-')[1] + '-' + state.orderId.split('-')[2];
document.getElementById('uploadBox').addEventListener('click', ()=>document.getElementById('fileInput').click());
const RESEP_MAX_SIZE = 5 * 1024 * 1024; // 5MB
const RESEP_ALLOWED_TYPES = ['image/jpeg','image/png','image/jpg','image/webp','application/pdf'];
document.getElementById('fileInput').addEventListener('change', e=>{
  if(!e.target.files.length) return;
  const file = e.target.files[0];

  // Validasi tipe file
  if(!RESEP_ALLOWED_TYPES.includes(file.type)){
    showToast('Gagal mengunggah resep', 'Format file tidak didukung. Gunakan JPG, PNG, atau PDF.', 'error');
    e.target.value = '';
    return;
  }
  // Validasi ukuran file
  if(file.size > RESEP_MAX_SIZE){
    showToast('Gagal mengunggah resep', 'Ukuran file melebihi 5MB. Silakan pilih file lain.', 'error');
    e.target.value = '';
    return;
  }

  state.customer.resep = file.name;
  document.getElementById('fileName').textContent = '✓ ' + file.name;
  document.getElementById('uploadBox').classList.remove('invalid-box');
  document.getElementById('err-resep').classList.remove('show');
  persist();
  showToast('Resep berhasil diunggah', file.name, 'success');
});
['custName','custPhone','custGender','custAge','custAddr','custNote','examDate'].forEach(id=>{
  const el = document.getElementById(id);
  const ev = (el.tagName === 'SELECT') ? 'change' : 'input';
  el.addEventListener(ev, e=>{
    const map = {custName:'name',custPhone:'phone',custGender:'gender',custAge:'age',custAddr:'addr',custNote:'note',examDate:'examDate'};
    state.customer[map[id]] = e.target.value;
    if(e.target.value.trim()) clearFieldError(id);
    persist();
  });
});
document.getElementById('namaPetugas').addEventListener('input', e=>{
  state.namaPetugas = e.target.value;
  if(e.target.value.trim()) clearFieldError('namaPetugas');
  persist();
});

/* ---------- FRAME & LENSA ---------- */
function renderFrames(){
  const grid = document.getElementById('frameGrid');
  const list = state.genderFilter==='Semua' ? FRAMES : FRAMES.filter(f=>f.gender===state.genderFilter);
  grid.innerHTML = list.map(f=>`
    <div class="frame-card ${f.id===state.selectedFrame?'selected':''}">
      <div class="frame-thumb">${FRAME_ICON}</div>
      <div class="frame-name">${f.name}</div>
      <div class="frame-price">${rupiah(f.price)}</div>
      <button class="frame-btn ${f.id===state.selectedFrame?'selected':''}" onclick="selectFrame('${f.id}')">
        ${f.id===state.selectedFrame?'Terpilih':'Pilih Frame'}
      </button>
    </div>
  `).join('');
}
function selectFrame(id){
  state.selectedFrame = id; state.inCart=false;
  document.getElementById('frameGrid').classList.remove('invalid-box');
  document.getElementById('err-frame').classList.remove('show');
  renderAll(); persist();
}

function renderLenses(){
  const grid = document.getElementById('lensGrid');
  grid.innerHTML = LENSES.map(l=>`
    <div class="lens-opt ${l.id===state.selectedLens?'selected':''}" onclick="selectLens('${l.id}')">
      <div class="left"><span class="radio-dot"></span>${l.name}</div>
      <div class="lens-price">${l.price===0?'Gratis':'+ '+rupiah(l.price)}</div>
    </div>
  `).join('');
}
function selectLens(id){
  state.selectedLens = id; state.inCart=false;
  document.getElementById('lensGrid').classList.remove('invalid-box');
  document.getElementById('err-lens').classList.remove('show');
  renderAll(); persist();
}

document.querySelectorAll('.chip').forEach(chip=>{
  chip.addEventListener('click', ()=>{
    document.querySelectorAll('.chip').forEach(c=>c.classList.remove('active'));
    chip.classList.add('active');
    state.genderFilter = chip.dataset.gender;
    renderFrames();
    persist();
  });
});

function addToCart(){
  let ok = true;
  document.getElementById('frameGrid').classList.remove('invalid-box');
  document.getElementById('err-frame').classList.remove('show');
  document.getElementById('lensGrid').classList.remove('invalid-box');
  document.getElementById('err-lens').classList.remove('show');

  if(!state.selectedFrame){
    document.getElementById('frameGrid').classList.add('invalid-box');
    document.getElementById('err-frame').classList.add('show');
    ok = false;
  }
  if(!state.selectedLens){
    document.getElementById('lensGrid').classList.add('invalid-box');
    document.getElementById('err-lens').classList.add('show');
    ok = false;
  }
  if(!ok){
    showToast('Harap isi atau memilih terlebih dahulu', 'Pilih frame dan jenis lensa sebelum melanjutkan.');
    document.getElementById('frameGrid').scrollIntoView({behavior:'smooth', block:'center'});
    return;
  }

  state.inCart = true;
  goTo('pemesanan');
}

/* ---------- COMPUTED ---------- */
function getFrame(){ return FRAMES.find(f=>f.id===state.selectedFrame); }
function getLens(){ return LENSES.find(l=>l.id===state.selectedLens); }
function computeTotals(){
  const frame = getFrame(), lens = getLens();
  if(!frame || !lens){
    return {frame:null, lens:null, productTotal:0, dp:0, diskon:0, subtotal:0};
  }
  const productTotal = frame.price + lens.price;
  const dp = Math.round(productTotal*0.5);
  const diskon = 0;
  const subtotal = dp - diskon;
  return {frame, lens, productTotal, dp, diskon, subtotal};
}

/* ---------- PEMESANAN ---------- */
function renderPemesanan(){
  const {frame, lens, productTotal, dp, diskon, subtotal} = computeTotals();
  document.getElementById('sumName').textContent = state.customer.name || '—';
  document.getElementById('sumCustId').textContent = 'CUST-' + state.orderId.split('-')[2];
  document.getElementById('sumResep').textContent = state.customer.resep || (state.customer.note ? state.customer.note : '—');

  document.getElementById('cartThumb').innerHTML = FRAME_ICON;
  document.getElementById('cartFrameName').textContent = frame ? frame.name : 'Belum ada frame dipilih';
  document.getElementById('cartLensName').textContent = (frame && lens) ? ('Warna: Hitam · ' + lens.name) : '—';
  document.getElementById('cartFramePrice').textContent = rupiah(productTotal);

  document.getElementById('priceDp').textContent = rupiah(dp);
  document.getElementById('priceDiskon').textContent = '-' + rupiah(diskon);
  document.getElementById('priceSubtotal').textContent = rupiah(subtotal);
  document.getElementById('priceTotal').textContent = rupiah(productTotal);
}

/* ---------- TOAST NOTIFICATION ---------- */
function showToast(title, detail, type='error'){
  const wrap = document.getElementById('toastWrap');
  const el = document.createElement('div');
  el.className = 'toast' + (type === 'success' ? ' toast-success' : '');
  const icon = type === 'success'
    ? '<path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/>'
    : '<path d="M12 8v5M12 16h.01" stroke-linecap="round"/>';
  el.innerHTML = `
    <span class="ic"><svg viewBox="0 0 24 24">${icon}</svg></span>
    <div class="txt"><b>${title}</b>${detail ? '<span>'+detail+'</span>' : ''}</div>
  `;
  wrap.appendChild(el);
  requestAnimationFrame(()=> el.classList.add('show'));
  setTimeout(()=>{
    el.classList.remove('show');
    setTimeout(()=> el.remove(), 300);
  }, 3200);
}

/* ---------- VALIDATION ---------- */
function clearFieldError(id){
  const input = document.getElementById(id);
  if(input) input.classList.remove('invalid');
  const err = document.getElementById('err-'+id);
  if(err) err.classList.remove('show');
}
function markFieldError(id, isBox){
  const input = document.getElementById(id);
  if(input) input.classList.add(isBox ? 'invalid-box' : 'invalid');
  const err = document.getElementById('err-'+id);
  if(err) err.classList.add('show');
}

// Validasi form Pemeriksaan (data pelanggan & resep)
function validatePemeriksaan(){
  const fields = ['namaPetugas','custName','custPhone','custGender','custAge','custAddr'];
  fields.forEach(clearFieldError);
  clearFieldError('examDate');
  document.getElementById('uploadBox').classList.remove('invalid-box');
  document.getElementById('err-resep').classList.remove('show');

  let firstInvalidLabel = null;
  let ok = true;

  fields.forEach(id=>{
    const val = document.getElementById(id).value.trim();
    if(!val){
      markFieldError(id);
      ok = false;
      if(!firstInvalidLabel) firstInvalidLabel = id;
    }
  });

  if(!document.getElementById('examDate').value){
    markFieldError('examDate');
    ok = false;
    if(!firstInvalidLabel) firstInvalidLabel = 'examDate';
  }

  if(!state.customer.resep){
    document.getElementById('uploadBox').classList.add('invalid-box');
    document.getElementById('err-resep').classList.add('show');
    ok = false;
    if(!firstInvalidLabel) firstInvalidLabel = 'resep';
  }

  return {ok, firstInvalidLabel};
}

function handleNextFromPemeriksaan(){
  const {ok, firstInvalidLabel} = validatePemeriksaan();
  if(!ok){
    showToast('Harap isi atau memilih terlebih dahulu', 'Lengkapi seluruh bagian yang ditandai merah sebelum melanjutkan.');
    const target = document.getElementById(firstInvalidLabel === 'resep' ? 'uploadBox' : firstInvalidLabel);
    if(target) target.scrollIntoView({behavior:'smooth', block:'center'});
    return;
  }
  goTo('frame');
}

