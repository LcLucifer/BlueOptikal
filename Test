<script>
/* ---------- DATA ---------- */
const FRAMES = [
  {id:'vw', name:'VIVIENNE WESTWOOD', price:1970000, gender:'Wanita'},
  {id:'ht', name:'HANG TEN', price:675000, gender:'Pria'},
