const PAY_METHODS = [
  {id:'va', name:'Transfer Bank (Virtual Account)', icon:`<path d="M3 10l9-6 9 6"/><path d="M4 10v9h16v-9"/><path d="M9 21v-6h6v6"/>`},
  {id:'qris', name:'QRIS', icon:`<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><path d="M14 14h3v3h-3zM19 14h2v2h-2zM14 19h2v2h-2zM19 19h2v2h-2z"/>`},
  {id:'store', name:'Bayar di Toko (Kasir Optik)', icon:`<path d="M3 9l1-5h16l1 5"/><path d="M4 9v10a1 1 0 001 1h14a1 1 0 001-1V9"/><rect x="9" y="13" width="6" height="6"/>`},
];
function renderPayOpts(){
  const wrap = document.getElementById('payOpts');
  wrap.innerHTML = PAY_METHODS.map(m=>`
    <div class="pay-opt ${state.payMethod===m.id?'selected':''}" onclick="selectPay('${m.id}')">
      <div class="left"><svg viewBox="0 0 24 24" stroke-width="1.6" fill="none">${m.icon}</svg>${m.name}</div>
      <span class="check-dot"></span>
    </div>
  `).join('');
  document.getElementById('vaBox').style.display = state.payMethod==='va' ? 'flex':'none';
  document.getElementById('qrisBox').style.display = state.payMethod==='qris' ? 'flex':'none';
}
function selectPay(id){ state.payMethod = id; renderPayOpts(); persist(); }
function setFulfil(type){
  state.fulfil = type;
  document.getElementById('fulfilStore').classList.toggle('selected', type==='store');
  document.getElementById('fulfilDeliver').classList.toggle('selected', type==='deliver');
  persist();
}
function copyVA(){
  navigator.clipboard?.writeText('8077356736875234536');
  const btn = document.getElementById('copyBtn');
  document.getElementById('copyLabel').textContent = 'Tersalin';
  btn.classList.add('copied');
  setTimeout(()=>{ document.getElementById('copyLabel').textContent='Salin'; btn.classList.remove('copied'); }, 1800);
}
function confirmPay(){
  // Pastikan metode pengambilan & metode pembayaran sudah dipilih
  if(!state.fulfil || !state.payMethod){
    showToast('Harap isi atau memilih terlebih dahulu', 'Pilih metode pengambilan dan metode pembayaran.');
    return;
  }

  // Pastikan data pemeriksaan & resep sudah lengkap sebelum pembayaran diproses
  const {ok} = validatePemeriksaan();
  if(!ok){
    showToast('Harap isi atau memilih terlebih dahulu', 'Data pemeriksaan pelanggan belum lengkap. Anda akan diarahkan kembali.');
    goTo('pemeriksaan');
    return;
  }

  state.status = 'paid';
  persist();
  document.getElementById('doneOrderId').textContent = state.orderId;
  document.getElementById('successOverlay').classList.add('show');
}
function closeOverlay(){
  document.getElementById('successOverlay').classList.remove('show');
  resetOrder();
}

function resetOrder(){
  // Set ulang seluruh state ke kondisi order baru yang kosong
  state.customer = {name:'',phone:'',gender:'',age:'',addr:'',note:'',resep:''};
  state.selectedFrame = null;
  state.selectedLens = null;
  state.genderFilter = 'Semua';
  state.inCart = false;
  state.fulfil = 'store';
  state.payMethod = 'va';
  state.namaPetugas = '';
  state.status = null;
  state.orderId = genOrderId();

  // Kosongkan input form secara langsung
  ['custName','custPhone','custAge'].forEach(id=> document.getElementById(id).value = '');
  document.getElementById('custGender').value = '';
  document.getElementById('custAddr').value = '';
  document.getElementById('custNote').value = '';
  document.getElementById('examDate').value = '';
  document.getElementById('namaPetugas').value = '';
  document.getElementById('fileInput').value = '';
  document.getElementById('fileName').textContent = '';

  // Bersihkan semua tanda peringatan/validasi dari order sebelumnya
  ['namaPetugas','custName','custPhone','custGender','custAge','custAddr','examDate'].forEach(clearFieldError);
  document.getElementById('uploadBox').classList.remove('invalid-box');
  document.getElementById('err-resep').classList.remove('show');
  document.getElementById('frameGrid').classList.remove('invalid-box');
  document.getElementById('err-frame').classList.remove('show');
  document.getElementById('lensGrid').classList.remove('invalid-box');
  document.getElementById('err-lens').classList.remove('show');

  document.querySelectorAll('.chip').forEach(c=>c.classList.toggle('active', c.dataset.gender === 'Semua'));

  populateFormFromState();
  renderAll();
  goTo('pemeriksaan');
  persist();
}

/* ---------- TOP BAR ---------- */
function renderTopbar(){
  document.getElementById('orderId').textContent = state.orderId;
  const {subtotal} = computeTotals();
  const billChip = document.getElementById('billChip');
  if(currentView === 'pembayaran'){
    billChip.style.display = 'flex';
    document.getElementById('billAmt').textContent = rupiah(subtotal);
  } else {
    billChip.style.display = 'none';
  }
  document.getElementById('payAmount').textContent = rupiah(subtotal);
}

function renderAll(){
  renderFrames();
  renderLenses();
  renderPemesanan();
  renderPayOpts();
  renderTopbar();
}

function populateFormFromState(){
  document.getElementById('custName').value = state.customer.name || '';
  document.getElementById('custPhone').value = state.customer.phone || '';
  document.getElementById('custGender').value = state.customer.gender || '';
  document.getElementById('custAge').value = state.customer.age || '';
  document.getElementById('custAddr').value = state.customer.addr || '';
  document.getElementById('custNote').value = state.customer.note || '';
  document.getElementById('examDate').value = state.customer.examDate || '';
  document.getElementById('namaPetugas').value = state.namaPetugas || '';
  document.getElementById('noPeriksa').value = 'PX-' + state.orderId.split('-')[1] + '-' + state.orderId.split('-')[2];
  if(state.customer.resep){
    document.getElementById('fileName').textContent = '✓ ' + state.customer.resep;
  }
  document.querySelectorAll('.chip').forEach(c=>c.classList.toggle('active', c.dataset.gender === state.genderFilter));
  document.getElementById('fulfilStore').classList.toggle('selected', state.fulfil==='store');
  document.getElementById('fulfilDeliver').classList.toggle('selected', state.fulfil==='deliver');
}

async function initApp(){
  const lastId = Storage.getLastOrderId();
  if(lastId){
    const saved = await Storage.load(lastId);
    if(saved){
      state.orderId = lastId;
      Object.assign(state.customer, saved.customer || {});
      state.selectedFrame = saved.selectedFrame || state.selectedFrame;
      state.selectedLens = saved.selectedLens || state.selectedLens;
      state.genderFilter = saved.genderFilter || state.genderFilter;
      state.inCart = !!saved.inCart;
      state.fulfil = saved.fulfil || state.fulfil;
      state.payMethod = saved.payMethod || state.payMethod;
      state.namaPetugas = saved.namaPetugas || '';
      state.status = saved.status || null;
      populateFormFromState();
    }
  }
  renderAll();
  goTo(state.status === 'paid' ? 'pembayaran' : 'pemeriksaan');
  persist();
}

initApp();
</script>
