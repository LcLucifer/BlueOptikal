<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Blue Optikal — Pemesanan Kacamata</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --navy: #0F2E52;
    --navy-2: #143a68;
    --blue: #2F86D6;
    --blue-dim: #cfe4f7;
    --wash: #EEF6FC;
    --frame: #E6EAF0;
    --frame-dark: #d3dae3;
    --white: #FFFFFF;
    --amber: #EE9F3C;
    --ink: #16233B;
    --ink-soft: #5B6B85;
    --good: #2E9E6D;
    --radius: 14px;
    --radius-sm: 9px;
    --shadow: 0 8px 24px -12px rgba(15,46,82,0.25);
  }
  *{box-sizing:border-box;}
  body{margin:0;font-family:'Inter',sans-serif;color:var(--ink);background:var(--wash);}
  h1,h2,h3,.display{font-family:'Space Grotesk',sans-serif;}
  .mono{font-family:'IBM Plex Mono',monospace;}
  button{font-family:inherit;cursor:pointer;}
  input,select,textarea{font-family:inherit;}

  .app{display:flex;min-height:100vh;}

  /* ---------- SIDEBAR ---------- */
  .sidebar{
    width:250px;flex-shrink:0;
    background:linear-gradient(180deg,var(--navy) 0%, var(--navy-2) 100%);
    color:var(--white);
    display:flex;flex-direction:column;
    padding:28px 20px;
    position:sticky;top:0;height:100vh;
  }
  .brand{display:flex;align-items:center;gap:10px;margin-bottom:36px;}
  .brand-mark{width:38px;height:38px;flex-shrink:0;}
  .brand-name{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:1.15rem;line-height:1.1;}
  .brand-tag{font-size:.62rem;letter-spacing:.08em;color:#9db6d6;text-transform:uppercase;}

  .stepper{display:flex;flex-direction:column;gap:4px;flex:1;}
  .step-item{
    display:flex;align-items:center;gap:12px;
    padding:12px 12px;border-radius:12px;
    color:#c7d6ea;background:transparent;border:none;
    text-align:left;width:100%;transition:.2s;
    position:relative;
  }
  .step-item:hover{background:rgba(255,255,255,0.06);}
  .step-item.active{background:rgba(255,255,255,0.12);color:#fff;}
  .lens{
    width:30px;height:30px;border-radius:50%;
    display:flex;align-items:center;justify-content:center;
    flex-shrink:0;position:relative;
    border:2px solid #4a6690;
    transition:.25s;
  }
  .step-item.active .lens{
    border-color:var(--blue);
    box-shadow:0 0 0 4px rgba(47,134,214,0.28), 0 0 0 8px rgba(47,134,214,0.12);
    background:var(--blue);
  }
  .step-item.done .lens{background:var(--good);border-color:var(--good);}
  .lens svg{width:15px;height:15px;stroke:#c7d6ea;fill:none;}
  .step-item.active .lens svg, .step-item.done .lens svg{stroke:#fff;}
  .step-label{font-size:.9rem;font-weight:600;}
  .step-num{font-family:'IBM Plex Mono',monospace;font-size:.68rem;color:#7d93b3;display:block;margin-bottom:1px;}

  .contact{border-top:1px solid rgba(255,255,255,0.12);padding-top:16px;font-size:.78rem;color:#b7c8e0;display:flex;flex-direction:column;gap:9px;}
  .contact div{display:flex;align-items:center;gap:8px;}
  .contact svg{width:14px;height:14px;stroke:#8fa8cb;flex-shrink:0;}

  /* ---------- MAIN ---------- */
  .main{flex:1;padding:32px 40px 60px;max-width:1180px;}
  .topbar{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:28px;flex-wrap:wrap;gap:14px;}
  .order-meta{font-family:'IBM Plex Mono',monospace;font-size:.78rem;color:var(--ink-soft);letter-spacing:.02em;}
  .order-meta b{color:var(--navy);}
  .save-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#c3cedd;margin-left:4px;transition:.3s;}
  .save-dot.flash{background:var(--good);box-shadow:0 0 0 4px rgba(46,158,109,0.25);}
  .bill-chip{
    background:var(--navy);color:#fff;padding:10px 20px;border-radius:100px;
    font-size:.78rem;display:flex;align-items:center;gap:10px;
  }
  .bill-chip .amt{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:1.05rem;}

  .panel{
    background:var(--white);border-radius:var(--radius);
    box-shadow:var(--shadow);padding:30px 32px;margin-bottom:22px;
  }
  .panel h2{margin:0 0 4px;font-size:1.5rem;color:var(--navy);}
  .panel .sub{color:var(--ink-soft);font-size:.9rem;margin-bottom:22px;}
  .eyebrow{
    font-size:.72rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase;
    color:var(--blue);margin-bottom:12px;display:block;
  }

  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:26px;}
  @media(max-width:880px){.grid2{grid-template-columns:1fr;} .main{padding:24px 18px 60px;} .app{flex-direction:column;} .sidebar{width:100%;height:auto;position:relative;}}

  label{font-size:.82rem;font-weight:600;color:var(--ink);display:block;margin:14px 0 6px;}
  label:first-of-type{margin-top:0;}
  input[type=text], input[type=tel], input[type=date], select, textarea{
    width:100%;padding:11px 13px;border-radius:var(--radius-sm);
    border:1.5px solid var(--frame-dark);background:var(--wash);
    font-size:.92rem;color:var(--ink);outline:none;transition:.15s;
  }
  input:focus, select:focus, textarea:focus{border-color:var(--blue);background:#fff;box-shadow:0 0 0 3px var(--blue-dim);}
  textarea{resize:vertical;min-height:70px;}
  .row2{display:grid;grid-template-columns:1fr 1fr;gap:14px;}

  .upload-box{
    border:2px dashed var(--frame-dark);border-radius:var(--radius-sm);
    background:var(--wash);padding:26px;text-align:center;color:var(--ink-soft);
    cursor:pointer;transition:.15s;
  }
  .upload-box:hover{border-color:var(--blue);color:var(--blue);}
  .upload-box svg{width:26px;height:26px;stroke:currentColor;fill:none;margin-bottom:6px;}
  .upload-box .fname{margin-top:8px;font-size:.78rem;color:var(--good);font-weight:600;}

  .note-box{background:#FBF3E4;border:1px solid #EFD9A8;color:#7a5a1a;border-radius:var(--radius-sm);padding:12px 16px;font-size:.82rem;margin-top:18px;}

  .actions{display:flex;justify-content:space-between;margin-top:8px;}
  .btn{
    padding:12px 26px;border-radius:100px;font-weight:600;font-size:.88rem;border:none;transition:.15s;
  }
  .btn-primary{background:var(--blue);color:#fff;}
  .btn-primary:hover{background:#256bb0;}
  .btn-primary:disabled{background:#a9c6e3;cursor:not-allowed;}
  .btn-ghost{background:transparent;color:var(--ink-soft);border:1.5px solid var(--frame-dark);}
  .btn-ghost:hover{border-color:var(--ink-soft);color:var(--ink);}

  /* Frame & Lens */
  .filters{display:flex;gap:8px;justify-content:flex-end;margin-bottom:20px;}
  .chip{padding:8px 18px;border-radius:100px;border:1.5px solid var(--frame-dark);background:#fff;font-size:.82rem;font-weight:600;color:var(--ink-soft);}
  .chip.active{background:var(--navy);border-color:var(--navy);color:#fff;}

  .frame-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:28px;}
  @media(max-width:880px){.frame-grid{grid-template-columns:1fr;}}
  .frame-card{
    border:1.5px solid var(--frame-dark);border-radius:var(--radius);
    padding:18px;text-align:center;transition:.2s;position:relative;background:#fff;
  }
  .frame-card.selected{border-color:var(--blue);box-shadow:0 0 0 4px var(--blue-dim);}
  .frame-thumb{
    background:var(--wash);border-radius:10px;height:110px;
    display:flex;align-items:center;justify-content:center;margin-bottom:12px;
    overflow:hidden;
  }
  .frame-thumb svg{width:70px;height:70px;stroke:var(--navy);fill:none;stroke-width:1.4;}
  .frame-name{font-weight:700;font-size:.95rem;margin-bottom:2px;}
  .frame-price{color:var(--blue);font-weight:600;font-size:.88rem;margin-bottom:12px;}
  .frame-btn{width:100%;padding:10px;border-radius:9px;font-weight:600;font-size:.85rem;border:none;background:var(--frame);color:var(--ink-soft);}
  .frame-btn.selected{background:var(--blue);color:#fff;}

  .lens-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:22px;}
  @media(max-width:640px){.lens-grid{grid-template-columns:1fr;}}
  .lens-opt{
    display:flex;align-items:center;justify-content:space-between;
    border:1.5px solid var(--frame-dark);border-radius:var(--radius-sm);
    padding:14px 16px;cursor:pointer;transition:.15s;background:#fff;
  }
  .lens-opt.selected{border-color:var(--blue);background:var(--blue-dim);}
  .lens-opt .left{display:flex;align-items:center;gap:10px;font-weight:600;font-size:.88rem;}
  .radio-dot{width:18px;height:18px;border-radius:50%;border:2px solid var(--frame-dark);flex-shrink:0;position:relative;}
  .lens-opt.selected .radio-dot{border-color:var(--blue);}
  .lens-opt.selected .radio-dot::after{content:'';position:absolute;inset:3px;border-radius:50%;background:var(--blue);}
  .lens-price{font-size:.82rem;color:var(--ink-soft);font-weight:600;}
  .lens-opt.selected .lens-price{color:var(--blue);}

  /* Order summary */
  .info-card{background:var(--wash);border-radius:var(--radius-sm);padding:16px 18px;}
  .info-card .k{font-size:.7rem;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-soft);margin-bottom:3px;}
  .info-card .v{font-weight:600;font-size:.92rem;margin-bottom:10px;}
  .info-card .v:last-child{margin-bottom:0;}

  .product-row{display:flex;gap:16px;border-top:1px solid var(--frame);padding-top:18px;margin-top:18px;}
  .product-thumb{width:70px;height:70px;background:var(--wash);border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
  .product-thumb svg{width:44px;height:44px;stroke:var(--navy);fill:none;stroke-width:1.4;}
  .product-info{flex:1;}
  .product-info .pname{font-weight:700;}
  .product-info .pmeta{font-size:.8rem;color:var(--ink-soft);}
  .price-table{margin-top:16px;border-top:1px dashed var(--frame-dark);padding-top:14px;}
  .price-line{display:flex;justify-content:space-between;font-size:.88rem;padding:5px 0;color:var(--ink-soft);}
  .price-line.total{border-top:1px solid var(--frame-dark);margin-top:8px;padding-top:12px;font-size:1.1rem;font-weight:700;color:var(--navy);}
  .price-line.total .v{color:var(--blue);font-family:'Space Grotesk',sans-serif;}

  /* Payment */
  .pay-opt{
    display:flex;align-items:center;justify-content:space-between;
    border:1.5px solid var(--frame-dark);border-radius:var(--radius-sm);
    padding:16px 18px;margin-bottom:14px;cursor:pointer;transition:.15s;
  }
  .pay-opt.selected{border-color:var(--blue);background:var(--blue-dim);}
  .pay-opt .left{display:flex;align-items:center;gap:12px;font-weight:600;}
  .pay-opt svg{width:22px;height:22px;stroke:var(--navy);fill:none;stroke-width:1.5;}
  .check-dot{width:20px;height:20px;border-radius:6px;border:2px solid var(--frame-dark);position:relative;flex-shrink:0;}
  .pay-opt.selected .check-dot{border-color:var(--blue);background:var(--blue);}
  .pay-opt.selected .check-dot::after{content:'✓';position:absolute;inset:0;color:#fff;font-size:.7rem;display:flex;align-items:center;justify-content:center;}

  .va-box{
    background:var(--wash);border-radius:var(--radius-sm);padding:16px 18px;
    display:flex;justify-content:space-between;align-items:center;margin:-4px 0 18px;
    border:1px solid var(--frame);
  }
  .va-num{font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:1.05rem;letter-spacing:.03em;color:var(--navy);}
  .copy-btn{background:#fff;border:1.5px solid var(--frame-dark);padding:8px 16px;border-radius:100px;font-size:.8rem;font-weight:600;color:var(--ink-soft);display:flex;align-items:center;gap:6px;}
  .copy-btn svg{width:14px;height:14px;stroke:currentColor;fill:none;}
  .copy-btn.copied{border-color:var(--good);color:var(--good);}

  .qris-box{
    background:var(--wash);border-radius:var(--radius-sm);padding:20px;
    display:flex;flex-direction:column;align-items:center;text-align:center;
    border:1px solid var(--frame);margin:-4px 0 18px;
  }
  .qris-img{width:170px;height:170px;border-radius:10px;background:#fff;padding:10px;border:1px solid var(--frame-dark);object-fit:contain;}
  .qris-caption{font-size:.8rem;color:var(--ink-soft);margin-top:12px;max-width:260px;}

  .fulfil-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:8px;}
  @media(max-width:640px){.fulfil-grid{grid-template-columns:1fr;}}
  .fulfil-opt{
    border:1.5px solid var(--frame-dark);border-radius:var(--radius-sm);padding:16px;
    display:flex;align-items:center;gap:12px;cursor:pointer;font-weight:600;font-size:.88rem;
  }
  .fulfil-opt.selected{border-color:var(--blue);background:var(--blue-dim);}
  .fulfil-opt svg{width:22px;height:22px;stroke:var(--navy);fill:none;stroke-width:1.5;flex-shrink:0;}

  .confirm-btn{width:100%;padding:16px;border-radius:12px;background:var(--navy);color:#fff;font-weight:700;font-size:.95rem;border:none;margin-top:10px;transition:.15s;}
  .confirm-btn:hover{background:#0a2440;}

  /* Success overlay */
  .overlay{
    position:fixed;inset:0;background:rgba(15,46,82,0.55);display:none;
    align-items:center;justify-content:center;z-index:50;padding:20px;
  }
  .overlay.show{display:flex;}
  .success-card{background:#fff;border-radius:20px;padding:40px 36px;max-width:380px;text-align:center;}
  .success-ring{width:70px;height:70px;border-radius:50%;background:var(--good);display:flex;align-items:center;justify-content:center;margin:0 auto 18px;}
  .success-ring svg{width:34px;height:34px;stroke:#fff;fill:none;stroke-width:2.5;}
  .success-card h3{margin:0 0 8px;color:var(--navy);}
  .success-card p{color:var(--ink-soft);font-size:.9rem;margin-bottom:22px;}

  .frame-grid.invalid-box, .lens-grid.invalid-box{outline:2px solid #D9432E;outline-offset:6px;border-radius:12px;}
  ::placeholder{color:#a3adbd;}

  /* ---------- VALIDATION ---------- */
  .invalid{border-color:#D9432E !important;background:#FDF1EF !important;box-shadow:0 0 0 3px rgba(217,67,46,0.15) !important;}
  .invalid-box{border-color:#D9432E !important;box-shadow:0 0 0 3px rgba(217,67,46,0.15) !important;}
  .field-err{color:#D9432E;font-size:.74rem;font-weight:600;margin-top:5px;display:none;align-items:center;gap:5px;}
  .field-err.show{display:flex;}
  .field-err svg{width:12px;height:12px;stroke:#D9432E;fill:none;stroke-width:2.5;flex-shrink:0;}

  .toast-wrap{position:fixed;top:24px;left:50%;transform:translateX(-50%) translateY(-20px);z-index:100;
    display:flex;flex-direction:column;gap:10px;align-items:center;pointer-events:none;}
  .toast{
    background:#2A1210;color:#fff;padding:14px 20px;border-radius:12px;
    display:flex;align-items:center;gap:12px;box-shadow:0 12px 30px -8px rgba(0,0,0,0.4);
    font-size:.88rem;font-weight:600;max-width:420px;
    border-left:4px solid #D9432E;
    opacity:0;transform:translateY(-14px);transition:opacity .25s, transform .25s;
  }
  .toast.show{opacity:1;transform:translateY(0);}
  .toast .ic{width:20px;height:20px;flex-shrink:0;border-radius:50%;background:#D9432E;display:flex;align-items:center;justify-content:center;}
  .toast .ic svg{width:12px;height:12px;stroke:#fff;fill:none;stroke-width:3;}
  .toast .txt b{display:block;font-size:.92rem;margin-bottom:1px;}
  .toast .txt span{font-weight:400;color:#e7c9c5;font-size:.78rem;}
  .toast.toast-success{background:#12271e;border-left-color:var(--good);}
  .toast.toast-success .ic{background:var(--good);}
  .toast.toast-success .txt span{color:#bfe3d2;}
</style>
</head>
<body>

<div class="toast-wrap" id="toastWrap"></div>

<div class="app">
  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="brand">
      <svg class="brand-mark" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="12" cy="20" r="8" stroke="#fff" stroke-width="2.2"/>
        <circle cx="28" cy="20" r="8" stroke="#2F86D6" stroke-width="2.2"/>
        <path d="M20 18c0-2 2-3 3-1" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/>
        <path d="M4 19c0-2 1-3 2-3" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/>
      </svg>
      <div>
        <div class="brand-name">blue optikal</div>
        <div class="brand-tag">the clear lens maker</div>
      </div>
    </div>

    <nav class="stepper" id="stepper">
      <button class="step-item" data-view="pemeriksaan">
        <span class="lens"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6" stroke-width="2"/><path d="M21 21l-4.3-4.3" stroke-width="2" stroke-linecap="round"/></svg></span>
        <span><span class="step-num"></span><span class="step-label">Pemeriksaan</span></span>
      </button>
      <button class="step-item" data-view="frame">
        <span class="lens"><svg viewBox="0 0 24 24"><circle cx="6" cy="12" r="4" stroke-width="2"/><circle cx="18" cy="12" r="4" stroke-width="2"/><path d="M10 12h4" stroke-width="2"/></svg></span>
        <span><span class="step-num"></span><span class="step-label">Frame dan Lensa</span></span>
      </button>
      <button class="step-item" data-view="pemesanan">
        <span class="lens"><svg viewBox="0 0 24 24"><path d="M4 5h2l2 12h10l2-8H7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="10" cy="20" r="1.4" stroke-width="2"/><circle cx="17" cy="20" r="1.4" stroke-width="2"/></svg></span>
        <span><span class="step-num"></span><span class="step-label">Pemesanan</span></span>
      </button>
      <button class="step-item" data-view="pembayaran">
        <span class="lens"><svg viewBox="0 0 24 24"><path d="M3 9c3-3 6-4 9-2s6 1 9-2" stroke-width="2" stroke-linecap="round"/><path d="M3 15c3 3 6 4 9 2s6-1 9 2" stroke-width="2" stroke-linecap="round"/></svg></span>
        <span><span class="step-num"></span><span class="step-label">Pembayaran</span></span>
      </button>
    </nav>

    <div class="contact">
      <div><svg viewBox="0 0 24 24" stroke-width="2" fill="none"><path d="M12 21s7-6.5 7-12a7 7 0 10-14 0c0 5.5 7 12 7 12z"/><circle cx="12" cy="9" r="2.4"/></svg> Jl. Dipatiukur No.112</div>
      <div><svg viewBox="0 0 24 24" stroke-width="2" fill="none"><path d="M4 4h4l2 5-2.5 1.5a11 11 0 005 5L14 13l5 2v4a2 2 0 01-2 2C9.5 21 3 14.5 3 6a2 2 0 012-2z"/></svg> 082144256474</div>
      <div><svg viewBox="0 0 24 24" stroke-width="2" fill="none"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg> BlueOptical.OFC</div>
    </div>
  </aside>

  <!-- MAIN -->
  <main class="main">
    <div class="topbar">
      <div class="order-meta">ID PEMESANAN # <b id="orderId">—</b> <span id="saveDot" class="save-dot" title="Tersimpan otomatis"></span></div>
      <div class="bill-chip" id="billChip" style="display:none">Total Tagihan <span class="amt" id="billAmt">Rp 0</span></div>
    </div>

    <!-- ===================== VIEW 1: PEMERIKSAAN ===================== -->
    <section class="view" id="view-pemeriksaan">
      <div class="panel">
        <div class="row2">
          <div><label>No Pemeriksaan</label><input type="text" id="noPeriksa" placeholder="Terisi otomatis" readonly></div>
          <div><label>Nama Petugas</label><input type="text" id="namaPetugas" placeholder="cth. Rani A."><div class="field-err" id="err-namaPetugas"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>Harap isi atau memilih terlebih dahulu</div></div>
        </div>
      </div>

      <div class="grid2">
        <div class="panel">
          <span class="eyebrow">Informasi Pelanggan</span>
          <label>Nama Lengkap</label>
          <input type="text" id="custName" placeholder="cth. Amelia Putri">
          <div class="field-err" id="err-custName"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>Harap isi atau memilih terlebih dahulu</div>
          <label>No HP</label>
          <input type="tel" id="custPhone" placeholder="08xx xxxx xxxx">
          <div class="field-err" id="err-custPhone"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>Harap isi atau memilih terlebih dahulu</div>
          <div class="row2">
            <div><label>Jenis Kelamin</label>
              <select id="custGender"><option value="">Pilih</option><option>Pria</option><option>Wanita</option></select>
